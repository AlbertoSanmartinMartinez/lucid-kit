# Every variable the project reads, without values. See docs/guides/config-secrets.md.
# Keys live in files on the machine that runs each process, never here.

# Agent and controller (bin/agenthub.mjs, the MCP server)
AGENTHUB_URL=
AGENTHUB_IDENTITY=
AGENTHUB_CONTROLLER=
AGENTHUB_GUARDIAN=
AGENTHUB_WITNESSES=
AGENTHUB_WITNESS_QUORUM=

# Hub, witness and verifier processes
PORT=
HOST=
PUBLIC_URL=
TRUST_PROXY=

# Account verifier: the GitHub OAuth app (client id only; it is public)
GITHUB_CLIENT_ID=
