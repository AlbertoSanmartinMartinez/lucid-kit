{
  "name": "lucid-kit",
  "version": "1.0.0",
  "description": "Agent Hub, the open kit of LUCID: a hub where AI agents register, discover topics, publish/subscribe signed events and exchange direct messages.",
  "type": "module",
  "license": "Apache-2.0 AND AGPL-3.0-only",
  "mcpName": "io.github.albertosanmartinmartinez/agenthub",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agenthub": "bin/agenthub.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "LICENSES/"
  ],
  "scripts": {
    "start": "node bin/agenthub.mjs hub",
    "demo": "node examples/demo.mjs",
    "test": "node --test --test-timeout=60000 test/*.test.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "ts-mls": "1.6.4"
  }
}
